<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>CryptoSteg_Maven</groupId>
  <artifactId>CryptoSteg_Maven</artifactId>
  <version>${parent.build.version.scrypt}</version>
  <name>CryptoSteg_Maven</name>
  
  <parent>
  	<groupId>Parent_Project</groupId>
  	<artifactId>Parent_Project</artifactId>
  	<version>${parent.build.version.scrypt}</version>
  	<relativePath>../Parent_Project</relativePath>
  </parent>
  
  <packaging>jar</packaging>
  
  <properties>
    <export.jar.name>ScrYpT_${project.version}</export.jar.name>
  </properties>
  
  <build>
    <finalName>${export.jar.name}</finalName>
    <sourceDirectory>src</sourceDirectory>
    
    <plugins>
    
      <!-- download source code in Eclipse, best practice -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-eclipse-plugin</artifactId>
        <version>2.9</version>
        <configuration>
          <downloadSources>true</downloadSources>
          <downloadJavadocs>false</downloadJavadocs>
        </configuration>
      </plugin>
      
      <!-- COMPILER -->
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.7.0</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
        </configuration>
      </plugin>
      
      <!-- DEPENDENCY EXTRACTOR - If want to export single jars into LIBS -->
      <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.1.1</version>
          <executions>
              <execution>
                  <id>copy-dependencies</id>
                  <phase>prepare-package</phase>
                  <goals>
                      <goal>copy-dependencies</goal>
                  </goals>
                  <configuration>
	                  <skip>${export.multijar.skip}</skip>
	                  <overwrite>true</overwrite>
                      <outputDirectory>
                      	<!-- MULTIJAR LIBS UPDATE -->
                          ${export.directory.multijar.libs}
                          <!-- ECLIPSE_PRJ - ${project.build.directory}/libs -->
                      </outputDirectory>
                      <exclude>/**/*humbs.db</exclude>
                  </configuration>
              </execution>
          </executions>
      </plugin>
      
      <!-- JAR ASSEMBLER -->
      <plugin>
	    <groupId>org.apache.maven.plugins</groupId>
	    <artifactId>maven-assembly-plugin</artifactId>
	    <version>2.4.1</version>
	    <executions>

            <!-- FATJAR -->
	        <execution>
	            <id>make-assembly</id>
	            <phase>package</phase>
	            <goals>
	                <goal>single</goal>
	            </goals>
	            <configuration>
	            	<skipAssembly>${export.fatjar.skip}</skipAssembly>
	            	<overwrite>true</overwrite>
	                <outputDirectory>
	                       <!-- ${project.build.directory}/CENTRALIZED -->
	                       ${export.directory.fatjar.main}
                   	</outputDirectory>
                	<archive>
		                <manifest>
		                    <mainClass>
		                        maingUI.MainGuiGeneralAppStarter
		                    </mainClass>
		                </manifest>
	                </archive>
	                <descriptorRefs>
	                    <descriptorRef>jar-with-dependencies</descriptorRef>
	                </descriptorRefs>
	                <appendAssemblyId>false</appendAssemblyId>
	                
	                <exclude>/**/*humbs.db</exclude>
	            </configuration>
	        </execution>
	    </executions>
	  </plugin>
	  
	  <!-- EXPORT RESOURCES TO BOTH MULTIJAR AND FATJAR EXPORT DIRS -->
  	  <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.1.0</version>
        <executions>

          <!-- MULTIJAR : .root -->
          <execution>
            <id>copy-resources -> ${export.directory.multijar.main}</id>
            <phase>install</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
            	<export.launcher.jarmode>false</export.launcher.jarmode>
            	<tasks>
					<echo>SINGLE_MAIN_JAR SOURCE: /target/ScrYpT_${parent.build.version.scrypt}.jar</echo>
				</tasks>
            	<skip>${export.multijar.skip}</skip>
            	<overwrite>true</overwrite>
              	<outputDirectory>
              		<!-- ${basedir}/target/ScrYpT_${parent.build.version.scrypt}.jar -->
              		${export.directory.multijar.main}
              	</outputDirectory>
               	<name>timestamp</name>
               	<pattern>yyyy-MM-dd_HH:mm:ss</pattern>
               	<timeZone>Europe/Zurich</timeZone>
			    <resources>
			    	 <!-- Resources -->
				     <resource>
					    <filtering>true</filtering>
					    <directory>./</directory>
					    <includes>
					        <include>resourcesFilePathsMappings.properties</include>
     					    <include>LAUNCHER/**/*</include>
					        <include>LAUNCHER/*</include>
					    </includes>
					    <excludes>/**/*humbs.db</excludes>
					 </resource>
					 <!-- Main scrypt's jar (not fatjar) just compiled in /target -->
				     <resource>
					    <filtering>false</filtering>
					    <directory>target/</directory>
					    <includes>
					        <include>${export.jar.name}.jar</include>
					    </includes>
					</resource>
			    </resources>     
            </configuration>            
          </execution>
          <!-- MULTIJAR : Resources_ScrYpt -->
          <execution>
            <id>copy-resources -> ${export.directory.multijar.resources}</id>
            <phase>validate</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
            	<skip>${export.multijar.skip}</skip>
            	<overwrite>true</overwrite>
              	<outputDirectory>
              		<!-- ${basedir}/target/extra-resources -->
              		${export.directory.multijar.resources}
              	</outputDirectory>
               	<name>timestamp</name>
               	<pattern>yyyy-MM-dd_HH:mm:ss</pattern>
               	<timeZone>Europe/Zurich</timeZone>
			    <resources>
				     <resource>
					    <filtering>true</filtering>
					    <directory>./Resources_Scrypt</directory>
					    <includes>
					    	<include>/Readme/**</include>
					    	<include>/Readme/**/*</include>
					    </includes>
					    <excludes>
					    	/**/*Thumbs.db
					    </excludes>
					</resource>
					<resource>
						<filtering>false</filtering>
				        <directory>./Resources_Scrypt</directory>
    					<includes>
    						<include>/PanelTempFiles</include>
    						<include>/PanelTempFiles/*</include>
    						<include>/Backup/*</include>
    						<include>/Images/*</include>
					        <include>/Icons/*</include>
					        <include>/ProgrammingLanguagesWords/*</include>
    						<include>/Images/**</include>
					        <include>/Icons/**</include>
					        <include>/ProgrammingLanguagesWords/**</include>
					    </includes>
					    <excludes>
					    	/**/*Thumbs.db
					    </excludes>
					</resource>
			    </resources>     
            </configuration>            
          </execution>
          
          <!-- FATJAR -->
          <execution>
            <id>copy-resources -> ${export.directory.fatjar.main}</id>
            <phase>validate</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
            	<export.launcher.jarmode>true</export.launcher.jarmode>
            	<skip>${export.fatjar.skip}</skip>
            	<overwrite>true</overwrite>
              	<outputDirectory>
              		<!-- ${basedir}/target/extra-resources -->
              		${export.directory.fatjar.main}
              	</outputDirectory>
               	<name>timestamp</name>
               	<pattern>yyyy-MM-dd_HH:mm:ss</pattern>
               	<timeZone>Europe/Zurich</timeZone>
			    <resources>
				     <resource>
					    <filtering>true</filtering>
					    <directory>./</directory>
					    <includes>
					        <include>resourcesFilePathsMappings.properties</include>
					        <include>LAUNCHER/**/*</include>
					        <include>LAUNCHER/*</include>
					    </includes>
					</resource>
			    </resources>     
            </configuration>            
          </execution>
          <!-- FATJAR : Resources_ScrYpt -->
          <execution>
            <id>copy-resources -> ${export.directory.fatjar.resources}</id>
            <phase>validate</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
            	<skip>${export.fatjar.skip}</skip>
            	<overwrite>true</overwrite>
              	<outputDirectory>
              		<!-- ${basedir}/target/extra-resources -->
              		${export.directory.fatjar.resources}
              	</outputDirectory>
               	<name>timestamp</name>
               	<pattern>yyyy-MM-dd_HH:mm:ss</pattern>
               	<timeZone>Europe/Zurich</timeZone>
			    <resources>
				     <resource>
					    <filtering>true</filtering>
					    <directory>./Resources_Scrypt</directory>
					    <includes>
					    	<include>/Readme/**</include>
					    	<include>/Readme/**/*</include>
					    </includes>
					    <excludes>
					    	/**/*Thumbs.db
					    </excludes>
					</resource>
					<resource>
						<filtering>false</filtering>
				        <directory>./Resources_Scrypt</directory>
    					<includes>
    						<include>/Backup/*</include>
    						<include>/PanelTempFiles</include>
    						<include>/PanelTempFiles/*</include>
    						<include>/Images/*</include>
					        <include>/Icons/*</include>
					        <include>/ProgrammingLanguagesWords/*</include>
    						<include>/Images/**</include>
					        <include>/Icons/**</include>
					        <include>/ProgrammingLanguagesWords/**</include>
					    </includes>
					    <excludes>
					    	/**/*Thumbs.db
					    </excludes>
					</resource>
			    </resources>     
            </configuration>            
          </execution>
        </executions>
      </plugin>
	  
 	</plugins>
  </build>
  
  <dependencies>
  	
	 	<dependency>
	   	<groupId>org.drjekyll</groupId>
	   	<artifactId>fontchooser</artifactId>
	   	<version>2.4</version>
	</dependency>
	
	<!-- IMPORTS FROM OTHER PROJECTS -->
	
	<dependency>
		<groupId>Initializer_Configs</groupId>
	    <artifactId>Initializer_Configs</artifactId>
	    <version>0.0.1-SNAPSHOT</version>
	</dependency>
	
	<dependency>
		<groupId>ScrYpT-Crypter</groupId>
	 	<artifactId>ScrYpT-Crypter</artifactId>
	 	<version>0.0.1-SNAPSHOT</version>
	</dependency>
	
	<dependency>
		<groupId>GuiTextEditorCommons</groupId>
	   	<artifactId>GuiTextEditorCommons</artifactId>
	  	<version>0.0.1-SNAPSHOT</version>
	</dependency>
	
	<dependency>
		<groupId>ScrYpT_LauncherV2</groupId>
		<artifactId>ScrYpT_LauncherV2</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<!-- <scope>compile</scope> -->
	</dependency>
	
	<dependency>
		<groupId>GuiCommons</groupId>
		<artifactId>GuiCommons</artifactId>
	 	<version>0.0.1-SNAPSHOT</version>
	</dependency>
	
	<dependency>
	  <groupId>GenCommons</groupId>
	  <artifactId>GenCommons</artifactId>
	  <version>0.0.1-SNAPSHOT</version>	
	</dependency>
	
	<dependency>
		<groupId>MultimediaConversion</groupId>
	  	<artifactId>MultimediaConversion</artifactId>
	 	<version>0.0.1-SNAPSHOT</version>
	</dependency>
		
	<dependency>
		<groupId>HardwareCommons</groupId>
 		<artifactId>HardwareCommons</artifactId>
 		<version>0.0.1-SNAPSHOT</version>
	</dependency>
	
	<dependency>
		<groupId>UltimateCalculator</groupId>
		<artifactId>UltimateCalculator</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</dependency>
	
	<dependency>
		<groupId>NetworkCommons</groupId>
		<artifactId>NetworkCommons</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</dependency>

  </dependencies>
  
	<repositories>
	   	<repository>
	        <id>central</id>
	        <name>jcenter</name>
	        <url>http://jcenter.bintray.com</url>
	   	</repository>
   	    <repository>
	      	<id>Local-repository-Main</id>
	      	<name>Main LOCAL Repository</name>
	      	<url>file:C:\Users\xx\.m2\repository</url>
	    </repository>
	</repositories>
</project>