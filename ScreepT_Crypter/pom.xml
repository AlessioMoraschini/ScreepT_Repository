<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ScreepT_Crypter</groupId>
  <artifactId>ScreepT_Crypter</artifactId>
  <version>1.0</version>
  
  <packaging>jar</packaging>
  
  <name>ScreepT_Crypter</name>
  <description>
  	This module contains the core cripting functionalities of ScreepT, including the built-in brand new algorithm CryptoSTEG.
  	Furthermore, here you can find different utilities to encode and entrophize bytes to use and reorder them back.
  </description>
  <url>${project.main.url}</url>
  <inceptionYear>${inception.year}</inceptionYear>
  <licenses>
    <license>
      <name>${project.license.name}</name>
      <url>${project.license.url}</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>${developer.url}</name>
    </developer>
  </developers>
  
  <parent>
  	<groupId>ScreepT_Parent</groupId>
  	<artifactId>ScreepT_Parent</artifactId>
  	<version>${parent.build.version.screept}</version>
  	<relativePath>../ScreepT_Parent</relativePath>
  </parent>
  
  <build>
    <sourceDirectory>src</sourceDirectory>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.7.0</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
        </configuration>
      </plugin>
      
      <!-- BUILD OBFUSCATION -->
   	<plugin>
	    <groupId>com.github.wvengen</groupId>
	    <artifactId>proguard-maven-plugin</artifactId>
	    <version>2.2.0</version>

           <executions>
               <execution>
                   <phase>package</phase>
                   <goals><goal>proguard</goal></goals>
               </execution>
           </executions>
           <configuration>
               <proguardVersion>6.2.0</proguardVersion>
               <obfuscate>true</obfuscate>
               <options>
              		<option>-target 1.8</option>
               </options>
               <libs>
                   <lib>${java.home}/lib/rt.jar</lib>
               </libs>
               <dependencies>
               	<dependency>
				    <groupId>com.github.wvengen</groupId>
				    <artifactId>proguard-maven-plugin</artifactId>
				    <version>2.2.0</version>
				</dependency>
				                
                   <dependency>
				    <groupId>net.sf.proguard</groupId>
				    <artifactId>proguard-base</artifactId>
				    <version>6.2.0</version>
				</dependency>
				<dependency>
				    <groupId>net.sf.proguard</groupId>
				    <artifactId>proguard-parent</artifactId>
				    <version>6.2.0</version>
				    <type>pom</type>
				</dependency>
									

               </dependencies>
           </configuration>
       </plugin>
    </plugins>
  </build>

  <dependencies>

	<dependency>
	    <groupId>junit</groupId>
	    <artifactId>junit</artifactId>
	    <version>4.12</version>
	    <scope>provided</scope>
	</dependency>
	
	<dependency>
		<groupId>testUtils</groupId>
		<artifactId>testUtils</artifactId>
		<version>1.0</version>
	    <scope>test</scope>
	</dependency>
	
	<dependency>
		<groupId>VariousCommonsLight</groupId>
		<artifactId>VariousCommonsLight</artifactId>
		<version>1.0</version>
	</dependency>
	
  </dependencies>
</project>
