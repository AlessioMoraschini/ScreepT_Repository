<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ScreepT_Launcher</groupId>
  <artifactId>ScreepT_Launcher</artifactId>
  <version>1.0</version>
  <parent>
  	<groupId>ScreepT_Parent</groupId>
  	<artifactId>ScreepT_Parent</artifactId>
  	<version>${parent.build.version.screept}</version>
  	<relativePath>../ScreepT_Parent</relativePath>
  </parent>
  
  <packaging>jar</packaging>
  
  	<properties>
  		<export.jar.name>ScreepT_Launcher</export.jar.name>
  	
		<!-- #################### LICENSE COMMON DATA ################# -->
		<developer.name>AM-Design-Development - (Alessio Moraschini)</developer.name>
		<developer.mail>info@am-design-development.com</developer.mail>
		<inception.year>2019</inception.year>
		<current.year>2020</current.year>
		<project.license.name>Proprietary dual License (Freeware|Commercial)</project.license.name>
		<project.main.url>https://www.am-design-development.com</project.main.url>
		<project.license.url>../License_ScreepT.html</project.license.url>
	</properties>
  
  <name>ScreepT_Launcher</name>
  <description>ScreepT_Launcher is the module that's used to configure and start the main application, creating a custom launcher that fits the current OS, but maintaining the portability of the whole software.</description>
  <url>${project.main.url}</url>
  <inceptionYear>${inception.year}</inceptionYear>
  <licenses>
    <license>
      <name>${project.license.name}</name>
      <url>${project.license.url}</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>${developer.name}</name>
    </developer>
  </developers>
  
  <scm>
      <connection>scm:git:http://127.0.0.1/dummy</connection>
      <developerConnection>scm:git:https://127.0.0.1/dummy</developerConnection>
      <tag>HEAD</tag>
      <url>http://127.0.0.1/dummy</url>
  </scm>
  
  <build>
  	<finalName>${export.jar.name}</finalName>
    <sourceDirectory>src</sourceDirectory>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.7.0</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
        </configuration>
      </plugin>
      	
      <!-- JAR ASSEMBLER : LAUNCHER -->
      <plugin>
	    <groupId>org.apache.maven.plugins</groupId>
	    <artifactId>maven-assembly-plugin</artifactId>
	    <version>2.4.1</version>
	    <executions>
        	<!-- FATJAR DIR -->
	        <execution>
	            <id>make-assembly -> ${export.directory.fatjar.main}</id>
	            <phase>package</phase>
	            <goals>
	                <goal>single</goal>
	            </goals>
	            <configuration>
	            	<skipAssembly>${export.fatjar.launcher.skip}</skipAssembly>
	                <outputDirectory>
	                    <!-- ${project.build.directory}/CENTRALIZED -->
	                    <!-- ${export.directory.multijar.main} -->
	                    ${export.directory.fatjar.main}
                   	</outputDirectory>
                	<archive>
		                <manifest>
		                    <mainClass>
		                        mainlauncher.ScreepTLauncher
		                    </mainClass>
		                </manifest>
		                <manifestEntries>
			              	<Created-by>${developer.name}</Created-by>
			              	<Built-By>${developer.name}</Built-By>
			              	<Build-number>${buildNumber}</Build-number>
			              	<Build-git-hash>${git.commit.id}</Build-git-hash>
		                </manifestEntries>
	                </archive>
	                <descriptorRefs>
	                    <descriptorRef>jar-with-dependencies</descriptorRef>
	                </descriptorRefs>
	                <appendAssemblyId>false</appendAssemblyId>
	            </configuration>
	        </execution>

        	<!-- UPDATES FOLDER -->
	        <execution>
	            <id>make-assembly -> ${export.updates.folder}</id>
	            <phase>package</phase>
	            <goals>
	                <goal>single</goal>
	            </goals>
	            <configuration>
	            	<skipAssembly>${export.updates.regenjars.skip}</skipAssembly>
	                <outputDirectory>
	                    ${export.updates.folder}
                   	</outputDirectory>
                	<archive>
		                <manifest>
		                    <mainClass>
		                        mainlauncher.ScreepTLauncher
		                    </mainClass>
		                </manifest>
	                </archive>
	                <descriptorRefs>
	                    <descriptorRef>jar-with-dependencies</descriptorRef>
	                </descriptorRefs>
	                <appendAssemblyId>false</appendAssemblyId>
	            </configuration>
	        </execution>
        	
        	<!-- MULTIJAR -->
	        <execution>
	            <id>make-assembly -> ${export.directory.multijar.main}</id>
	            <phase>package</phase>
	            <goals>
	                <goal>single</goal>
	            </goals>
	            <configuration>
	            	<skipAssembly>${export.multijar.launcher.skip}</skipAssembly>
	                <outputDirectory>
	                       <!-- ${project.build.directory}/CENTRALIZED -->
	                       ${export.directory.multijar.main}
                   	</outputDirectory>
                	<archive>
		                <manifest>
		                    <mainClass>
		                        mainlauncher.ScreepTLauncher
		                    </mainClass>
		                </manifest>
	                </archive>
	                <descriptorRefs>
	                    <descriptorRef>jar-with-dependencies</descriptorRef>
	                </descriptorRefs>
	                <appendAssemblyId>false</appendAssemblyId>
	            </configuration>
	        </execution>
	    </executions>
	  </plugin>
	  
	  <!-- Add Build number into manifest -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>buildnumber-maven-plugin</artifactId>
        <version>1.4</version>
        <executions>
          <execution>
            <phase>validate</phase>
            <goals>
              <goal>create</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
	       	<format>{0,number,integer}</format>
		    <items>
		        <item>buildNumber</item>
		    </items>
			<doCheck>false</doCheck>
			<doUpdate>false</doUpdate>
        </configuration>
      </plugin>
	  
    </plugins>
  </build>
  
  <dependencies>
	<!-- Exclude test only dependencies -->
	<dependency>
		<groupId>junit</groupId>
		<artifactId>junit</artifactId>
		<version>4.12</version>
		<scope>test</scope>
	</dependency>
	
	<dependency>
		<groupId>testUtils</groupId>
		<artifactId>testUtils</artifactId>
		<version>1.0</version>
		<scope>test</scope>
	</dependency>
		
	<dependency>
		<groupId>org.ini4j</groupId>
		<artifactId>ini4j</artifactId>
		<version>0.5.4</version>
	</dependency>
	
	<dependency>
	    <groupId>com.miglayout</groupId>
	    <artifactId>miglayout</artifactId>
	    <version>3.7.4</version>
	</dependency>

	<!-- IMPORTS FROM OTHER PROJECTS -->
	
	<dependency>
		<groupId>Resources</groupId>
	  	<artifactId>Resources</artifactId>
	  	<version>1.0</version>
	</dependency>
	
	<dependency>
		<groupId>VariousCommonsLight</groupId>
		<artifactId>VariousCommonsLight</artifactId>
		<version>1.0</version>
		<exclusions>
			<exclusion>
				<groupId>commons-io</groupId>
			    <artifactId>commons-io</artifactId>
			</exclusion>
			<exclusion>
				<groupId>commons-net</groupId>
		    	<artifactId>commons-net</artifactId>
			</exclusion>
		</exclusions>
	</dependency>
	
	<dependency>	
		<groupId>OsCommons</groupId>
	  	<artifactId>OsCommons</artifactId>
	  	<version>1.0</version>
 	</dependency>
  </dependencies>
  
  
</project>