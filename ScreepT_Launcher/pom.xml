<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>ScreepT_Launcher</groupId>
	<artifactId>ScreepT_Launcher</artifactId>
	<version>1.1-SNAPSHOT</version>

	<parent>
		<groupId>ScreepT_Parent</groupId>
		<artifactId>ScreepT_Parent</artifactId>
		<version>${screept.parent.version}</version>
		<relativePath>../../ScreepT-public/ScreepT_Parent</relativePath>
	</parent>

	<packaging>jar</packaging>

	<properties>
		<export.jar.name>ScreepT_Launcher</export.jar.name>
	</properties>

	<name>ScreepT_Launcher</name>
	<description>ScreepT_Launcher is the module that's used to configure and start the main application, creating a custom launcher that fits the current OS, but maintaining the portability of the whole software.</description>
	<url>${project.main.url}</url>

	<!-- SCREEPT LICENSE -->
	<inceptionYear>${screept.start.year}</inceptionYear>
	<licenses>
		<license>
			<name>${screept.license.name}</name>
			<url>${screept.license.url}</url>
		</license>
	</licenses>
	<developers>
		<developer>
			<name>${developer.name}</name>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:http://127.0.0.1/dummy</connection>
		<developerConnection>scm:git:https://127.0.0.1/dummy</developerConnection>
		<tag>HEAD</tag>
		<url>http://127.0.0.1/dummy</url>
	</scm>

	<build>
		<finalName>${export.jar.name}</finalName>
		<sourceDirectory>src</sourceDirectory>

		<plugins>

			<!-- Properties inherited from parent -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>properties-maven-plugin</artifactId>
				<executions>
					<execution>
						<phase>validate</phase>
						<goals>
							<goal>read-project-properties</goal>
						</goals>
						<configuration>
							<files>
								<file>${project.parent.relativePath}/${properties.location}</file>
							</files>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>${maven.compiler.version}</version>
				<configuration>
					<source>${jdk.source.level}</source>
					<target>${jdk.target.level}</target>
				</configuration>
			</plugin>

			<!-- JAR ASSEMBLER : LAUNCHER -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>2.4.1</version>
				<executions>
					<!-- FATJAR DIR -->
					<execution>
						<id>make-assembly -> ${export.directory.fatjar.main}</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
						<configuration>
							<skipAssembly>${export.fatjar.launcher.skip}</skipAssembly>
							<outputDirectory>
								<!-- ${project.build.directory}/CENTRALIZED -->
								<!-- ${export.directory.multijar.main} -->
								${export.directory.fatjar.main}
							</outputDirectory>
							<archive>
								<manifest>
									<mainClass>
										mainlauncher.ScreepTLauncher
									</mainClass>
								</manifest>
								<manifestEntries>
									<Created-by>${developer.name}</Created-by>
									<Built-By>${developer.name}</Built-By>
									<Build-number>${buildNumber}</Build-number>
									<Build-git-hash>${git.commit.id}</Build-git-hash>
								</manifestEntries>
							</archive>
							<descriptorRefs>
								<descriptorRef>jar-with-dependencies</descriptorRef>
							</descriptorRefs>
							<appendAssemblyId>false</appendAssemblyId>
						</configuration>
					</execution>

					<!-- MULTIJAR -->
					<execution>
						<id>make-assembly -> ${export.directory.multijar.main}</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
						<configuration>
							<skipAssembly>${export.multijar.launcher.skip}</skipAssembly>
							<outputDirectory>
								<!-- ${project.build.directory}/CENTRALIZED -->
								${export.directory.multijar.main}
							</outputDirectory>
							<archive>
								<manifest>
									<mainClass>
										mainlauncher.ScreepTLauncher
									</mainClass>
								</manifest>
							</archive>
							<descriptorRefs>
								<descriptorRef>jar-with-dependencies</descriptorRef>
							</descriptorRefs>
							<appendAssemblyId>false</appendAssemblyId>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Add Build number into manifest -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>buildnumber-maven-plugin</artifactId>
				<version>1.4</version>
				<executions>
					<execution>
						<phase>validate</phase>
						<goals>
							<goal>create</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<format>{0,number,integer}</format>
					<items>
						<item>buildNumber</item>
					</items>
					<doCheck>false</doCheck>
					<doUpdate>false</doUpdate>
				</configuration>
			</plugin>

		</plugins>
	</build>

	<dependencies>
		<!-- Exclude test only dependencies -->
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>testUtils</groupId>
			<artifactId>testUtils</artifactId>
			<version>${test.utils.version}</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.ini4j</groupId>
			<artifactId>ini4j</artifactId>
			<version>${ini4j.version}</version>
		</dependency>

		<dependency>
			<groupId>com.miglayout</groupId>
			<artifactId>miglayout</artifactId>
			<version>${miglayout.version}</version>
		</dependency>

		<!-- IMPORTS FROM OTHER PROJECTS -->

		<dependency>
			<groupId>Resources</groupId>
			<artifactId>Resources</artifactId>
			<version>${general.resources.version}</version>
		</dependency>
		
		<dependency>
			<groupId>UpdaterModule</groupId>
			<artifactId>UpdaterModule</artifactId>
			<version>${updater.version}</version>
			<exclusions>
				<exclusion>
					<groupId>VariousCommonsLight</groupId>
					<artifactId>VariousCommonsLight</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.ini4j</groupId>
					<artifactId>ini4j</artifactId>
				</exclusion>
				<exclusion>
					<groupId>com.miglayout</groupId>
					<artifactId>miglayout</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		

		<dependency>
			<groupId>VariousCommonsLight</groupId>
			<artifactId>VariousCommonsLight</artifactId>
			<version>${various.common.version}</version>
			<exclusions>
				<exclusion>
					<groupId>commons-io</groupId>
					<artifactId>commons-io</artifactId>
				</exclusion>
				<exclusion>
					<groupId>commons-net</groupId>
					<artifactId>commons-net</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<dependency>
			<groupId>OsCommons</groupId>
			<artifactId>OsCommons</artifactId>
			<version>${os.commons.version}</version>
		</dependency>
	</dependencies>


</project>