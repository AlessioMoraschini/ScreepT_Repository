<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ScrYpT_LauncherV2</groupId>
  <artifactId>ScrYpT_LauncherV2</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <parent>
  	<groupId>Parent_Project</groupId>
  	<artifactId>Parent_Project</artifactId>
  	<version>${parent.build.version.scrypt}</version>
  	<relativePath>../Parent_Project</relativePath>
  </parent>
  
  <packaging>jar</packaging>
  
  <properties>
	<export.jar.name>ScrYpT_Launcher</export.jar.name>
  </properties>
  
  <build>
  	<finalName>${export.jar.name}</finalName>
    <sourceDirectory>src</sourceDirectory>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.7.0</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
        </configuration>
      </plugin>
      	
      <!-- JAR ASSEMBLER : LAUNCHER -->
      <plugin>
	    <groupId>org.apache.maven.plugins</groupId>
	    <artifactId>maven-assembly-plugin</artifactId>
	    <version>2.4.1</version>
	    <executions>
        	<!-- FATJAR DIR -->
	        <execution>
	            <id>make-assembly -> ${export.directory.fatjar.main}</id>
	            <phase>package</phase>
	            <goals>
	                <goal>single</goal>
	            </goals>
	            <configuration>
	            	<skipAssembly>${export.fatjar.launcher.skip}</skipAssembly>
	                <outputDirectory>
	                    <!-- ${project.build.directory}/CENTRALIZED -->
	                    <!-- ${export.directory.multijar.main} -->
	                    ${export.directory.fatjar.main}
                   	</outputDirectory>
                	<archive>
		                <manifest>
		                    <mainClass>
		                        mainlauncher.ScrYpTLauncher
		                    </mainClass>
		                </manifest>
	                </archive>
	                <descriptorRefs>
	                    <descriptorRef>jar-with-dependencies</descriptorRef>
	                </descriptorRefs>
	                <appendAssemblyId>false</appendAssemblyId>
	            </configuration>
	        </execution>
        	<!-- MULTIJAR -->
	        <execution>
	            <id>make-assembly -> ${export.directory.multijar.main}</id>
	            <phase>package</phase>
	            <goals>
	                <goal>single</goal>
	            </goals>
	            <configuration>
	            	<skipAssembly>${export.multijar.launcher.skip}</skipAssembly>
	                <outputDirectory>
	                       <!-- ${project.build.directory}/CENTRALIZED -->
	                       ${export.directory.multijar.main}
                   	</outputDirectory>
                	<archive>
		                <manifest>
		                    <mainClass>
		                        mainlauncher.ScrYpTLauncher
		                    </mainClass>
		                </manifest>
	                </archive>
	                <descriptorRefs>
	                    <descriptorRef>jar-with-dependencies</descriptorRef>
	                </descriptorRefs>
	                <appendAssemblyId>false</appendAssemblyId>
	            </configuration>
	        </execution>
	    </executions>
	  </plugin>
	  
    </plugins>
  </build>
  
  <dependencies>
	<dependency>
		<groupId>org.ini4j</groupId>
		<artifactId>ini4j</artifactId>
		<version>0.5.4</version>
	</dependency>
	<dependency>
	    <groupId>org.apache.commons</groupId>
	    <artifactId>commons-lang3</artifactId>
	    <version>3.9</version>
	</dependency>
	
	<dependency>
	    <groupId>com.miglayout</groupId>
	    <artifactId>miglayout</artifactId>
	    <version>3.7.4</version>
	</dependency>

	<!-- IMPORTS FROM OTHER PROJECTS -->
	
	<dependency>
		<groupId>Resources</groupId>
	  	<artifactId>Resources</artifactId>
	  	<version>0.0.1-SNAPSHOT</version>
	</dependency>
	
	<dependency>	
		<groupId>OsCommons</groupId>
	  	<artifactId>OsCommons</artifactId>
	  	<version>0.0.1-SNAPSHOT</version>
 	</dependency>

  </dependencies>
  
  
</project>