<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>ScrYpT_LauncherV2</groupId>
  <artifactId>ScrYpT_LauncherV2</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <parent>
  	<groupId>Parent_Project</groupId>
  	<artifactId>Parent_Project</artifactId>
  	<version>${parent.build.version.scrypt}</version>
  	<relativePath>../Parent_Project</relativePath>
  </parent>
  
  <packaging>jar</packaging>
  
  <properties>
	<export.jar.name>ScrYpT_Launcher</export.jar.name>
  </properties>
  
  <build>
  	<finalName>${export.jar.name}</finalName>
    <sourceDirectory>src</sourceDirectory>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.7.0</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
        </configuration>
      </plugin>
      	
      <!-- JAR ASSEMBLER -->
      <plugin>
	    <groupId>org.apache.maven.plugins</groupId>
	    <artifactId>maven-assembly-plugin</artifactId>
	    <version>2.4.1</version>
	    <executions>
	        <execution>
	            <id>make-assembly</id>
	            <phase>package</phase>
	            <goals>
	                <goal>single</goal>
	            </goals>
	            <configuration>
	                <outputDirectory>
	                       ${project.build.directory}/CENTRALIZED
                   	</outputDirectory>
                	<archive>
		                <manifest>
		                    <mainClass>
		                        mainlauncher.ScrYpTLauncher
		                    </mainClass>
		                </manifest>
	                </archive>
	                <descriptorRefs>
	                    <descriptorRef>jar-with-dependencies</descriptorRef>
	                </descriptorRefs>
	                <appendAssemblyId>false</appendAssemblyId>
	            </configuration>
	        </execution>
	    </executions>
	  </plugin>
	  
	  <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>copy-resources</id>
            <!-- here the phase you need -->
            <phase>validate</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              	<outputDirectory>${basedir}/target/extra-resources</outputDirectory>
               	<name>timestamp</name>
               	<pattern>yyyy-MM-dd_HH:mm:ss</pattern>
               	<timeZone>Europe/Zurich</timeZone>
			    <resources>
				     <resource>
					    <filtering>true</filtering>
					    <directory>./</directory>
					    <includes>
					        <include>resourcesFilePathsMappings.properties</include>
					    </includes>
					</resource>
			    </resources>     
            </configuration>            
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  
  
  
  <dependencies>
	<dependency>
		<groupId>org.ini4j</groupId>
		<artifactId>ini4j</artifactId>
		<version>0.5.4</version>
	</dependency>

	<!-- IMPORTS FROM OTHER PROJECTS -->
	<dependency>
		<groupId>GuiCommons</groupId>
		<artifactId>GuiCommons</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</dependency>
	
	<dependency>
		<groupId>Resources</groupId>
	  	<artifactId>Resources</artifactId>
	  	<version>0.0.1-SNAPSHOT</version>
	</dependency>
	
	<dependency>	
		<groupId>OsCommons</groupId>
	  	<artifactId>OsCommons</artifactId>
	  	<version>0.0.1-SNAPSHOT</version>
 	</dependency>

  </dependencies>
  
  
</project>