<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>UpdaterModule</groupId>
  <artifactId>UpdaterModule</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>UpdaterModule</name>
   
  <parent>
  	<groupId>Parent_Project</groupId>
  	<artifactId>Parent_Project</artifactId>
  	<version>${parent.build.version.scrypt}</version>
  	<relativePath>../Parent_Project</relativePath>
  </parent>
  
  <packaging>jar</packaging>
  
  <scm>
      <connection>scm:git:http://127.0.0.1/dummy</connection>
      <developerConnection>scm:git:https://127.0.0.1/dummy</developerConnection>
      <tag>HEAD</tag>
      <url>http://127.0.0.1/dummy</url>
  </scm>
  
  <build>
    <sourceDirectory>src</sourceDirectory>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.7.0</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
        </configuration>
      </plugin>
      <plugin>
	    <groupId>org.apache.maven.plugins</groupId>
	    <artifactId>maven-assembly-plugin</artifactId>
	    <version>2.4.1</version>
	    <executions>

            <!-- UPDATER.JAR EXPORT TO UPDATES DIR -->
	        <execution>
	            <id>make-assembly</id>
	            <phase>package</phase>
	            <goals>
	                <goal>single</goal>
	            </goals>
	            <configuration>
	            	<outputDirectory>${export.updates.root}</outputDirectory>
	           	 	<finalName>updater</finalName>
	            	<skipAssembly>false</skipAssembly>
	            	<overwrite>true</overwrite>
                	<archive>
		                <manifest>
		                    <mainClass>
		                        main.MainStandAloneUpdater
		                    </mainClass>
		                </manifest>
		                <manifestEntries>
			              	<Created-by>${user.name}</Created-by>
		                	<Built-By>${user.name}</Built-By>
			              	<Build-number>${buildNumber}</Build-number>
		                </manifestEntries>
	                </archive>
	                <descriptorRefs>
	                    <descriptorRef>jar-with-dependencies</descriptorRef>
	                </descriptorRefs>
	                <appendAssemblyId>false</appendAssemblyId>
	                
	                <exclude>/**/*humbs.db</exclude>
	            </configuration>
	        </execution>
	    </executions>
	  </plugin>
	  
	  <!-- Add Build number into manifest -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>buildnumber-maven-plugin</artifactId>
        <version>1.4</version>
        <executions>
          <execution>
            <phase>validate</phase>
            <goals>
              <goal>create</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
	       	<format>{0,number,integer}</format>
		    <items>
		        <item>buildNumber</item>
		    </items>
			<doCheck>false</doCheck>
			<doUpdate>false</doUpdate>
        </configuration>
      </plugin>
    </plugins>
  </build>
  
  <dependencies>
  
  	<dependency>
	    <groupId>com.miglayout</groupId>
	    <artifactId>miglayout</artifactId>
	    <version>3.7.4</version>
	</dependency>
  
	<dependency>
	    <groupId>commons-net</groupId>
	    <artifactId>commons-net</artifactId>
	    <version>3.6</version>
	</dependency>
	
	<dependency>
		<groupId>org.ini4j</groupId>
		<artifactId>ini4j</artifactId>
		<version>0.5.4</version>
	</dependency>
	
	<dependency>
	    <groupId>commons-io</groupId>
	    <artifactId>commons-io</artifactId>
	    <version>2.6</version>
	</dependency>
	
  </dependencies>
</project>