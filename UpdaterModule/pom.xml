<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>UpdaterModule</groupId>
  <artifactId>UpdaterModule</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>UpdaterModule</name>
   
  <parent>
  	<groupId>Parent_Project</groupId>
  	<artifactId>Parent_Project</artifactId>
  	<version>${parent.build.version.scrypt}</version>
  	<relativePath>../Parent_Project</relativePath>
  </parent>
  
  <packaging>jar</packaging>
  
  <build>
    <sourceDirectory>src</sourceDirectory>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.7.0</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
        </configuration>
      </plugin>
      <plugin>
	    <groupId>org.apache.maven.plugins</groupId>
	    <artifactId>maven-assembly-plugin</artifactId>
	    <version>2.4.1</version>
	    <executions>

            <!-- UPDATER.JAR EXPORT TO UPDATES DIR -->
	        <execution>
	            <id>make-assembly</id>
	            <phase>package</phase>
	            <goals>
	                <goal>single</goal>
	            </goals>
	            <configuration>
	            	<outputDirectory>${export.updates.root}</outputDirectory>
	           	 	<finalName>updater</finalName>
	            	<skipAssembly>false</skipAssembly>
	            	<overwrite>true</overwrite>
                	<archive>
		                <manifest>
		                    <mainClass>
		                        main.MainStandAloneUpdater
		                    </mainClass>
		                </manifest>
	                </archive>
	                <descriptorRefs>
	                    <descriptorRef>jar-with-dependencies</descriptorRef>
	                </descriptorRefs>
	                <appendAssemblyId>false</appendAssemblyId>
	                
	                <exclude>/**/*humbs.db</exclude>
	            </configuration>
	        </execution>
	    </executions>
	  </plugin>
    </plugins>
  </build>
  
  <dependencies>
  
	<dependency>
	    <groupId>commons-net</groupId>
	    <artifactId>commons-net</artifactId>
	    <version>3.6</version>
	</dependency>
	
	<dependency>
		<groupId>org.ini4j</groupId>
		<artifactId>ini4j</artifactId>
		<version>0.5.4</version>
	</dependency>
	
	<dependency>
	    <groupId>commons-io</groupId>
	    <artifactId>commons-io</artifactId>
	    <version>2.6</version>
	</dependency>
	
  </dependencies>
</project>