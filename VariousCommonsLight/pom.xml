<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>VariousCommonsLight</groupId>
	<artifactId>VariousCommonsLight</artifactId>
	<version>1.0</version>

	<parent>
		<groupId>Parent_Project</groupId>
		<artifactId>Parent_Project</artifactId>
		<version>${parent.build.version.screept}</version>
		<relativePath>../Parent_Project</relativePath>
	</parent>

	<packaging>jar</packaging>

	<build>
		<sourceDirectory>src</sourceDirectory>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.7.0</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>
			
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>2.4.1</version>
				<executions>
			
					<!-- (1) FATJAR BUILD AND EXPORT -->
					<execution>
						<id>make-assembly - main fatjar folder</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
						<configuration>
							<skipAssembly>true</skipAssembly>
							<overwrite>true</overwrite>
							<outputDirectory>
								${project.build.directory}/CENTRALIZED
							</outputDirectory>
							<archive>
								<manifest>
								</manifest>
								<manifestEntries>
									<Created-by>${user.name}</Created-by>
									<Built-By>${user.name}</Built-By>
									<Build-number>${buildNumber}</Build-number>
									<Build-git-hash>${git.commit.id}</Build-git-hash>
								</manifestEntries>
							</archive>
							<descriptorRefs>
								<descriptorRef>jar-with-dependencies</descriptorRef>
							</descriptorRefs>
							<appendAssemblyId>false</appendAssemblyId>
							<exclude>/**/*humbs.db</exclude>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	
	<dependencies>
	
	  	<!-- Exclude test only dependencies from build -->
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.12</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>testUtils</groupId>
			<artifactId>testUtils</artifactId>
			<version>1.0</version>
			<scope>test</scope>
		</dependency>
		
		<dependency>
		    <groupId>commons-io</groupId>
		    <artifactId>commons-io</artifactId>
		    <version>2.6</version>
		</dependency>
			
		<dependency>
		    <groupId>commons-net</groupId>
		    <artifactId>commons-net</artifactId>
		    <version>3.6</version>
		</dependency>
		
	</dependencies>
</project>