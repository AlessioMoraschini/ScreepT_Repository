<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>HardwareCommons</groupId>
  <artifactId>HardwareCommons</artifactId>
  <version>0.0.1-SNAPSHOT</version>
    
  <parent>
  	<groupId>Parent_Project</groupId>
  	<artifactId>Parent_Project</artifactId>
  	<version>${parent.build.version.scrypt}</version>
  	<relativePath>../Parent_Project</relativePath>
  </parent>
  
  <packaging>jar</packaging>
  
  <build>
   	<finalName>HardwareInfoTool.jar</finalName>
    <sourceDirectory>src</sourceDirectory>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.7.0</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
        </configuration>
      </plugin>
      
	   <plugin>
	    <groupId>org.apache.maven.plugins</groupId>
	    <artifactId>maven-assembly-plugin</artifactId>
	    <version>2.4.1</version>
	    <executions>

            <!-- FATJAR -->
	        <execution>
	            <id>make-assembly</id>
	            <phase>package</phase>
	            <goals>
	                <goal>single</goal>
	            </goals>
	            <configuration>
	            	<skipAssembly>false</skipAssembly>
	            	<overwrite>true</overwrite>
                	<archive>
		                <manifest>
		                    <mainClass>
		                        guiVersion.HardwareInfoFrameLauncher
		                    </mainClass>
		                </manifest>
	                </archive>
	                <descriptorRefs>
	                    <descriptorRef>jar-with-dependencies</descriptorRef>
	                </descriptorRefs>
	                <appendAssemblyId>false</appendAssemblyId>
	                
	                <exclude>/**/*humbs.db</exclude>
	            </configuration>
	        </execution>
	    </executions>
	  </plugin>
    </plugins>
  </build>
  
  <dependencies>
  	
	<dependency>
	    <groupId>com.github.oshi</groupId>
	    <artifactId>oshi-core</artifactId>
	    <version>3.13.0</version>
	</dependency>
			
	<dependency>
	    <groupId>com.github.oshi</groupId>
	    <artifactId>oshi-parent</artifactId>
	    <version>3.13.0</version>
	    <type>pom</type>
	</dependency>
		
			 	 
 	<dependency>
	    <groupId>org.apache.httpcomponents</groupId>
	    <artifactId>httpclient</artifactId>
	    <version>4.5.7</version>
	</dependency>
	
	<dependency>
	    <groupId>commons-net</groupId>
	    <artifactId>commons-net</artifactId>
	    <version>3.6</version>
	</dependency>
  	
	<dependency>
	    <groupId>org.fusesource</groupId>
	    <artifactId>sigar</artifactId>
	    <version>1.6.4</version>
	</dependency>	
	<dependency>
		<groupId>GuiCommons</groupId>
		<artifactId>GuiCommons</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</dependency>
	<dependency>
	    <groupId>log4j</groupId>
	    <artifactId>log4j</artifactId>
	    <version>1.2.17</version>
	</dependency>
	
	<dependency>
	    <groupId>jnetpcap</groupId>
	    <artifactId>jnetpcap</artifactId>
	    <version>1.4.r1425-1g</version>
	</dependency>
  </dependencies>
	<repositories>
	   	<repository>
	        <id>clojars</id>
	        <name>clojars_Repo</name>
	        <url>https://clojars.org/repo/</url>
	   	</repository>
	</repositories>
</project>