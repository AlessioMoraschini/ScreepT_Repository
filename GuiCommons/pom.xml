<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>GuiCommons</groupId>
  <artifactId>GuiCommons</artifactId>
  <version>1.0</version>
  
  <parent>
  	<groupId>ScreepT_Parent</groupId>
  	<artifactId>ScreepT_Parent</artifactId>
  	<version>${parent.build.version.screept}</version>
  	<relativePath>../ScreepT_Parent</relativePath>
  </parent>
  
  <packaging>jar</packaging>
  
  <name>GuiCommons</name>
  <description>
  	This module is Specific for all the graphics functions needed by ScreepT project, in order to make them reusable in a future release.
  </description>
  <url>${project.main.url}</url>
  <inceptionYear>${inception.year}</inceptionYear>
  <licenses>
    <license>
      <name>${project.license.name}</name>
      <url>${project.license.url}</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>${developer.url}</name>
    </developer>
  </developers>
  
  <build>
    <sourceDirectory>src</sourceDirectory>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.7.0</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
        </configuration>
      </plugin>
    </plugins>
  </build>
  
  <repositories>
    <repository>
      <id>spring.io</id>
      <name>spring.io_REPO</name>
      <url>http://repo.spring.io/plugins-release/</url>
    </repository>
  </repositories>
  <dependencies> 
  
  	<!-- <dependency>
	    <groupId>com.jtattoo</groupId>
	    <artifactId>JTattoo</artifactId>
	    <version>1.6.11</version>
	</dependency> -->
	
	<!-- https://mvnrepository.com/artifact/com.jgoodies/looks -->
	<dependency>
	    <groupId>com.jgoodies</groupId>
	    <artifactId>looks</artifactId>
	    <version>2.2.2</version>
	</dependency>
	
 	<!-- <dependency>
	   	<groupId>org.drjekyll</groupId>
	   	<artifactId>fontchooser</artifactId>
	   	<version>2.4</version>
	</dependency> -->
	
	<dependency>
	    <groupId>com.miglayout</groupId>
	    <artifactId>miglayout</artifactId>
	    <version>3.7.4</version>
	</dependency>

	<dependency>
		<groupId>GenCommons</groupId>
		<artifactId>GenCommons</artifactId>
		<version>1.0</version>
	</dependency>
	
	<dependency>
		<groupId>Resources</groupId>
		<artifactId>Resources</artifactId>
		<version>1.0</version>
	</dependency>
	
	<dependency>
	  <groupId>OsCommons</groupId>
	  <artifactId>OsCommons</artifactId>
	  <version>1.0</version>
	</dependency>
	
	<dependency>
		<groupId>Initializer_Configs</groupId>
	    <artifactId>Initializer_Configs</artifactId>
	    <version>1.0</version>
	</dependency>
	
	<dependency>
		<groupId>UpdaterModule</groupId>
		<artifactId>UpdaterModule</artifactId>
		<version>1.0</version>
	</dependency>
	
  </dependencies>
</project>